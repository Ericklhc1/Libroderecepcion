# ---------------------------------------------------------------------------
# Libro Operativo de Recepción - variables de entorno
# Copiar a .env y completar. NUNCA versionar el archivo .env real.
# ---------------------------------------------------------------------------

# Conexión PostgreSQL usada por la aplicación.
# En proveedores con agrupador de conexiones (Neon, Supabase) es la URL agrupada.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/libro_recepcion?schema=public"

# Conexión directa, sin agrupador: la exigen las migraciones.
# En desarrollo es la misma que DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/libro_recepcion?schema=public"

# Base de datos usada por las pruebas de integración (se reinicia en cada corrida)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/libro_recepcion_test?schema=public"

# Secreto de firma de sesión (mínimo 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio-de-32-caracteres-minimo"

# Duración de la sesión en horas
SESSION_TTL_HOURS="12"

# Contraseña de los usuarios demo generados por el seed (solo desarrollo)
SEED_DEMO_PASSWORD="Demo2024!"

# Zona horaria operativa del hotel
HOTEL_TIMEZONE="America/Santiago"
