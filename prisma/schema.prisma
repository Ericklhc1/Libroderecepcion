// ---------------------------------------------------------------------------
// Libro Operativo de Recepción — modelo de datos
// PostgreSQL + Prisma. Eliminación lógica en todas las entidades operativas.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================== ENUMERACIONES ==============================

enum ShiftType {
  MANANA
  TARDE
  NOCHE
}

/// Ciclo de vida del turno. Las transiciones se validan en servidor.
enum ShiftStatus {
  PROGRAMADO
  INICIADO
  ACTIVO
  PREPARANDO_ENTREGA
  ENTREGA_ENVIADA
  RECIBIDO
  CERRADO
  ANULADO
}

enum HandoverStatus {
  BORRADOR
  ENVIADA
  RECIBIDA
}

enum HandoverLevel {
  URGENTE
  IMPORTANTE
  INFORMATIVO
}

enum AssignmentRole {
  TITULAR
  APOYO
}

/// Tipos de registro del libro operativo.
enum EntryType {
  NOVEDAD
  INCIDENCIA
  HUESPED
  RESERVA
  MANTENIMIENTO
  CAJA
  SEGURIDAD
  HOUSEKEEPING
  AYB
  SISTEMAS
  OTRO
}

enum EntryStatus {
  ABIERTO
  EN_CURSO
  EN_ESPERA
  RESUELTO
  CERRADO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Severity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Impact {
  NINGUNO
  HUESPED
  OPERACION
  ECONOMICO
  REPUTACIONAL
  SEGURIDAD
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  BLOQUEADA
  COMPLETADA
  CANCELADA
}

enum TaskOrigin {
  MANUAL
  REGISTRO
  INCIDENCIA
  ENTREGA_TURNO
  SEGUIMIENTO
  ALERTA
  RESERVA
}

enum FollowUpStatus {
  PENDIENTE
  CUMPLIDO
  VENCIDO
  CANCELADO
}

enum AlertType {
  GARANTIA_PENDIENTE
  TARJETA_INVALIDA
  PAGO_PENDIENTE
  RESERVA_SIN_CONFIRMAR
  SOLICITUD_HUESPED_PENDIENTE
  TAREA_VENCIDA
  INCIDENCIA_CRITICA
  MANTENIMIENTO_SIN_RESOLVER
  SEGUIMIENTO_VENCIDO
  ENTREGA_TURNO_PENDIENTE
  HUESPED_VIP
  SALIDA_ANTICIPADA
  TRASLADO_PENDIENTE
  OTRO
}

enum AlertLevel {
  INFORMATIVA
  ATENCION
  CRITICA
}

enum AlertStatus {
  NUEVA
  VISTA
  POSPUESTA
  RESUELTA
}

enum AuditAction {
  CREAR
  EDITAR
  CAMBIO_ESTADO
  CAMBIO_RESPONSABLE
  CAMBIO_PRIORIDAD
  CERRAR
  REABRIR
  ELIMINAR
  RESTAURAR
  COMENTAR
  TURNO_INICIAR
  TURNO_RECIBIR
  TURNO_ENTREGAR
  TURNO_CERRAR
  LOGIN
  LOGIN_FALLIDO
  LOGOUT
  CONFIGURAR
  PERMISOS
}

enum GuaranteeStatus {
  NO_REQUIERE
  PENDIENTE
  VALIDADA
  RECHAZADA
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  EN_CASA
  SALIDA
  NO_SHOW
  CANCELADA
}

enum NotificationType {
  TAREA_ASIGNADA
  RESPONSABLE_CAMBIADO
  VENCIMIENTO_PROXIMO
  TAREA_VENCIDA
  INCIDENCIA_CRITICA
  ENTREGA_DISPONIBLE
  COMENTARIO
  ACCION_REQUERIDA
}

// =============================== IDENTIDAD ================================

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  group       String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([group])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  /// Nivel jerárquico: mayor número = mayor alcance.
  level       Int              @default(10)
  /// Roles de sistema no pueden eliminarse ni renombrar su clave.
  isSystem    Boolean          @default(false)
  /// Si es false, el rol queda fuera de la operación habitual
  /// (no aparece como responsable, asignado ni en turnos).
  operational Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  phone              String?
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  isDemo             Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?

  sessions           Session[]
  assignments        ShiftAssignment[]
  shiftsCreated      Shift[]            @relation("shiftCreatedBy")
  handoversIssued    ShiftHandover[]    @relation("handoverIssuedBy")
  handoversReceived  ShiftHandover[]    @relation("handoverReceivedBy")
  entriesCreated     OperationalEntry[] @relation("entryCreatedBy")
  entriesOwned       OperationalEntry[] @relation("entryOwner")
  entriesClosed      OperationalEntry[] @relation("entryClosedBy")
  tasksCreated       Task[]             @relation("taskCreatedBy")
  tasksAssigned      Task[]             @relation("taskAssignee")
  followUpsOwned     FollowUp[]         @relation("followUpOwner")
  followUpsCreated   FollowUp[]         @relation("followUpCreatedBy")
  comments           Comment[]
  attachments        Attachment[]
  alertsCreated      Alert[]            @relation("alertCreatedBy")
  alertsAcknowledged Alert[]            @relation("alertAckBy")
  alertsResolved     Alert[]            @relation("alertResolvedBy")
  auditLogs          AuditLog[]
  notifications      Notification[]
  settingsUpdated    SystemSetting[]
  checklistDone      TaskChecklistItem[]

  @@index([roleId])
  @@index([active])
  @@index([deletedAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

// ================================= ÁREAS ==================================

model Department {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  color     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  entries   OperationalEntry[]
  tasks     Task[]
  alerts    Alert[]
}

// ================================= TURNOS =================================

model Shift {
  id            String      @id @default(cuid())
  date          DateTime    @db.Date
  type          ShiftType
  status        ShiftStatus @default(PROGRAMADO)
  plannedStart  DateTime
  plannedEnd    DateTime
  actualStart   DateTime?
  actualEnd     DateTime?
  notes         String?
  createdById   String?
  createdBy     User?       @relation("shiftCreatedBy", fields: [createdById], references: [id])
  startedById   String?
  closedById    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  isDemo        Boolean     @default(false)

  assignments   ShiftAssignment[]
  handoverOut   ShiftHandover?  @relation("handoverFromShift")
  handoverIn    ShiftHandover[] @relation("handoverToShift")
  entries       OperationalEntry[]
  tasks         Task[]

  @@unique([date, type])
  @@index([status])
  @@index([date])
}

model ShiftAssignment {
  id        String         @id @default(cuid())
  shiftId   String
  shift     Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AssignmentRole @default(TITULAR)
  createdAt DateTime       @default(now())

  @@unique([shiftId, userId])
  @@index([userId])
}

model ShiftHandover {
  id                   String         @id @default(cuid())
  /// Un turno sólo puede emitir una entrega: evita entregas duplicadas.
  fromShiftId          String         @unique
  fromShift            Shift          @relation("handoverFromShift", fields: [fromShiftId], references: [id])
  toShiftId            String?
  toShift              Shift?         @relation("handoverToShift", fields: [toShiftId], references: [id])
  status               HandoverStatus @default(BORRADOR)
  issuedById           String
  issuedBy             User           @relation("handoverIssuedBy", fields: [issuedById], references: [id])
  issuedAt             DateTime?
  receivedById         String?
  receivedBy           User?          @relation("handoverReceivedBy", fields: [receivedById], references: [id])
  receivedAt           DateTime?
  /// Fotografía inmutable del estado operativo al momento de enviar la entrega.
  snapshot             Json?
  notes                String?
  receiverObservations String?
  issuerSessionId      String?
  receiverSessionId    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isDemo               Boolean        @default(false)

  items                HandoverItem[]
  comments             Comment[]
  tasks                Task[]
  alerts               Alert[]

  @@index([status])
}

model HandoverItem {
  id         String        @id @default(cuid())
  handoverId String
  handover   ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  level      HandoverLevel @default(INFORMATIVO)
  /// Agrupador legible: "Incidencias abiertas", "Tareas pendientes", etc.
  section    String
  title      String
  detail     String?
  /// Referencia al registro de origen (entry|task|followup|alert|reservation).
  refType    String?
  refId      String?
  manual     Boolean       @default(false)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([handoverId])
}

// ============================ LIBRO OPERATIVO =============================

model OperationalEntry {
  id             String      @id @default(cuid())
  seq            Int         @unique @default(autoincrement())
  type           EntryType
  title          String
  description    String
  category       String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  priority       Priority    @default(MEDIA)
  status         EntryStatus @default(ABIERTO)
  occurredAt     DateTime    @default(now())
  dueAt          DateTime?
  tags           String[]    @default([])
  requiresFollowUp Boolean   @default(false)

  createdById    String
  createdBy      User        @relation("entryCreatedBy", fields: [createdById], references: [id])
  ownerId        String?
  owner          User?       @relation("entryOwner", fields: [ownerId], references: [id])
  shiftId        String?
  shift          Shift?      @relation(fields: [shiftId], references: [id])

  guestId        String?
  guest          GuestReference? @relation(fields: [guestId], references: [id])
  reservationId  String?
  reservation    ReservationReference? @relation(fields: [reservationId], references: [id])

  // --- Campos específicos de incidencia (nulos en otros tipos) ---
  severity        Severity?
  impact          Impact?
  immediateAction String?
  rootCause       String?
  resolution      String?

  closedAt       DateTime?
  closedById     String?
  closedBy       User?       @relation("entryClosedBy", fields: [closedById], references: [id])
  reopenedAt     DateTime?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean     @default(false)

  tasks          Task[]
  followUps      FollowUp[]
  comments       Comment[]
  attachments    Attachment[]
  alerts         Alert[]

  @@index([type, status])
  @@index([status, priority])
  @@index([occurredAt])
  @@index([ownerId])
  @@index([shiftId])
  @@index([deletedAt])
  @@index([departmentId])
}

model Task {
  id             String     @id @default(cuid())
  seq            Int        @unique @default(autoincrement())
  title          String
  description    String?
  status         TaskStatus @default(PENDIENTE)
  priority       Priority   @default(MEDIA)
  origin         TaskOrigin @default(MANUAL)
  dueAt          DateTime?
  tags           String[]   @default([])
  blockedReason  String?

  assigneeId     String?
  assignee       User?      @relation("taskAssignee", fields: [assigneeId], references: [id])
  createdById    String
  createdBy      User       @relation("taskCreatedBy", fields: [createdById], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  shiftId        String?
  shift          Shift?     @relation(fields: [shiftId], references: [id])

  entryId        String?
  entry          OperationalEntry? @relation(fields: [entryId], references: [id])
  handoverId     String?
  handover       ShiftHandover?    @relation(fields: [handoverId], references: [id])
  followUpId     String?
  followUp       FollowUp?         @relation("followUpTasks", fields: [followUpId], references: [id])
  alertId        String?
  sourceAlert    Alert?            @relation("alertTasks", fields: [alertId], references: [id])

  completedAt    DateTime?
  completedById  String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean    @default(false)

  checklist      TaskChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  followUps      FollowUp[]  @relation("taskFollowUps")
  alerts         Alert[]     @relation("taskAlerts")

  @@index([status, dueAt])
  @@index([assigneeId, status])
  @@index([entryId])
  @@index([deletedAt])
}

model TaskChecklistItem {
  id       String   @id @default(cuid())
  taskId   String
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean  @default(false)
  order    Int      @default(0)
  doneAt   DateTime?
  doneById String?
  doneBy   User?    @relation(fields: [doneById], references: [id])

  @@index([taskId])
}

model FollowUp {
  id             String         @id @default(cuid())
  action         String
  result         String?
  nextAction     String?
  scheduledAt    DateTime?
  notes          String?
  status         FollowUpStatus @default(PENDIENTE)

  ownerId        String
  owner          User           @relation("followUpOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User           @relation("followUpCreatedBy", fields: [createdById], references: [id])

  entryId        String?
  entry          OperationalEntry? @relation(fields: [entryId], references: [id])
  taskId         String?
  task           Task?          @relation("taskFollowUps", fields: [taskId], references: [id])

  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean        @default(false)

  comments       Comment[]
  alerts         Alert[]        @relation("followUpAlerts")
  tasks          Task[]         @relation("followUpTasks")

  @@index([status, scheduledAt])
  @@index([ownerId])
  @@index([entryId])
  @@index([deletedAt])
}

model Alert {
  id             String      @id @default(cuid())
  type           AlertType
  level          AlertLevel  @default(ATENCION)
  title          String
  message        String?
  status         AlertStatus @default(NUEVA)
  dueAt          DateTime?
  snoozedUntil   DateTime?
  /// Clave de deduplicación del motor automático (una alerta viva por origen).
  dedupeKey      String?     @unique
  auto           Boolean     @default(false)

  entryId        String?
  entry          OperationalEntry? @relation(fields: [entryId], references: [id])
  taskId         String?
  task           Task?       @relation("taskAlerts", fields: [taskId], references: [id])
  followUpId     String?
  followUp       FollowUp?   @relation("followUpAlerts", fields: [followUpId], references: [id])
  handoverId     String?
  handover       ShiftHandover? @relation(fields: [handoverId], references: [id])
  guestId        String?
  guest          GuestReference? @relation(fields: [guestId], references: [id])
  reservationId  String?
  reservation    ReservationReference? @relation(fields: [reservationId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  createdById    String?
  createdBy      User?       @relation("alertCreatedBy", fields: [createdById], references: [id])
  acknowledgedById String?
  acknowledgedBy User?       @relation("alertAckBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt DateTime?
  resolvedById   String?
  resolvedBy     User?       @relation("alertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean     @default(false)

  comments       Comment[]
  tasks          Task[]      @relation("alertTasks")

  @@index([status, level])
  @@index([type])
  @@index([deletedAt])
}

model Comment {
  id             String    @id @default(cuid())
  body           String
  authorId       String
  author         User      @relation(fields: [authorId], references: [id])
  entryId        String?
  entry          OperationalEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  followUpId     String?
  followUp       FollowUp? @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  alertId        String?
  alert          Alert?    @relation(fields: [alertId], references: [id], onDelete: Cascade)
  handoverId     String?
  handover       ShiftHandover? @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean   @default(false)

  @@index([entryId])
  @@index([taskId])
  @@index([authorId])
}

model Attachment {
  id           String   @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  entryId      String?
  entry        OperationalEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  deletedById  String?
  isDemo       Boolean  @default(false)

  @@index([entryId])
  @@index([taskId])
}

// ===================== REFERENCIAS DE HUÉSPED / RESERVA ====================
// Referencias ligeras: no reemplazan al PMS, permiten asociar registros y
// quedan listas para sincronizarse mediante `externalId`.

model GuestReference {
  id         String   @id @default(cuid())
  fullName   String
  roomNumber String?
  documentId String?
  email      String?
  phone      String?
  language   String?
  vip        Boolean  @default(false)
  notes      String?
  externalId String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  isDemo     Boolean  @default(false)

  reservations ReservationReference[]
  entries      OperationalEntry[]
  alerts       Alert[]

  @@index([fullName])
  @@index([roomNumber])
}

model ReservationReference {
  id              String            @id @default(cuid())
  code            String            @unique
  guestId         String?
  guest           GuestReference?   @relation(fields: [guestId], references: [id])
  roomNumber      String?
  checkIn         DateTime?
  checkOut        DateTime?
  channel         String?
  status          ReservationStatus @default(PENDIENTE)
  guaranteeStatus GuaranteeStatus   @default(NO_REQUIERE)
  balanceDue      Decimal?          @db.Decimal(12, 2)
  requiresAction  Boolean           @default(false)
  actionNote      String?
  notes           String?
  externalId      String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  isDemo          Boolean           @default(false)

  entries         OperationalEntry[]
  alerts          Alert[]

  @@index([status])
  @@index([requiresAction])
}

// ========================= TRAZABILIDAD Y SISTEMA =========================

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  summary   String
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  sessionId String?
  createdAt DateTime    @default(now())
  isDemo    Boolean     @default(false)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  isDemo    Boolean          @default(false)

  @@index([userId, readAt])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@index([category])
}
