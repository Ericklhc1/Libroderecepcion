// ---------------------------------------------------------------------------
// Libro Operativo de Recepción — modelo de datos
// PostgreSQL + Prisma. Eliminación lógica en todas las entidades operativas.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Conexión de la aplicación. En proveedores con agrupador de conexiones
  // (Neon, Supabase) es la URL agrupada.
  url       = env("DATABASE_URL")
  // Conexión directa, sin agrupador: la exigen las migraciones. En desarrollo
  // puede ser la misma que DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ============================== ENUMERACIONES ==============================

/// Las dos ventanas fijas del hotel: día 07:00-19:59 y noche 20:00-07:59.
///
/// Antes eran tres (MANANA/TARDE/NOCHE, de ocho horas). Los turnos históricos
/// de mañana y tarde se convirtieron a DIA en la migración
/// `20260916170000_turnos_dia_noche`, que es el mapeo más fiel: ambos ocurrían
/// dentro de la ventana diurna.
enum ShiftType {
  DIA
  NOCHE
}

/// Ciclo de vida del turno. Las transiciones se validan en servidor.
enum ShiftStatus {
  PROGRAMADO
  INICIADO
  ACTIVO
  PREPARANDO_ENTREGA
  ENTREGA_ENVIADA
  RECIBIDO
  CERRADO
  ANULADO
}

enum HandoverStatus {
  BORRADOR
  ENVIADA
  RECIBIDA
}

enum HandoverLevel {
  URGENTE
  IMPORTANTE
  INFORMATIVO
}

enum AssignmentRole {
  TITULAR
  APOYO
}

/// Tipos de registro del libro operativo.
enum EntryType {
  NOVEDAD
  INCIDENCIA
  HUESPED
  RESERVA
  MANTENIMIENTO
  CAJA
  SEGURIDAD
  HOUSEKEEPING
  AYB
  SISTEMAS
  OTRO
}

enum EntryStatus {
  ABIERTO
  EN_CURSO
  EN_ESPERA
  RESUELTO
  CERRADO
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Severity {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum Impact {
  NINGUNO
  HUESPED
  OPERACION
  ECONOMICO
  REPUTACIONAL
  SEGURIDAD
}

enum TaskStatus {
  PENDIENTE
  EN_CURSO
  BLOQUEADA
  COMPLETADA
  CANCELADA
}

enum TaskOrigin {
  MANUAL
  REGISTRO
  INCIDENCIA
  ENTREGA_TURNO
  SEGUIMIENTO
  ALERTA
  RESERVA
}

enum FollowUpStatus {
  PENDIENTE
  CUMPLIDO
  VENCIDO
  CANCELADO
}

enum AlertType {
  GARANTIA_PENDIENTE
  GARANTIA_SIN_RESOLVER_EN_SALIDA
  SALDO_PENDIENTE
  TARJETA_INVALIDA
  PAGO_PENDIENTE
  RESERVA_SIN_CONFIRMAR
  SOLICITUD_HUESPED_PENDIENTE
  TAREA_VENCIDA
  INCIDENCIA_CRITICA
  MANTENIMIENTO_SIN_RESOLVER
  SEGUIMIENTO_VENCIDO
  ENTREGA_TURNO_PENDIENTE
  HUESPED_VIP
  SALIDA_ANTICIPADA
  TRASLADO_PENDIENTE
  OTRO
}

enum AlertLevel {
  INFORMATIVA
  ATENCION
  CRITICA
}

enum AlertStatus {
  NUEVA
  VISTA
  POSPUESTA
  RESUELTA
}

enum AuditAction {
  CREAR
  EDITAR
  CAMBIO_ESTADO
  CAMBIO_RESPONSABLE
  CAMBIO_PRIORIDAD
  CERRAR
  REABRIR
  ELIMINAR
  RESTAURAR
  COMENTAR
  TURNO_INICIAR
  TURNO_RECIBIR
  TURNO_ENTREGAR
  TURNO_CERRAR
  LOGIN
  LOGIN_FALLIDO
  LOGOUT
  CONFIGURAR
  PERMISOS
}

enum GuaranteeStatus {
  NO_REQUIERE
  PENDIENTE
  VALIDADA
  RECHAZADA
}

/// Estado del ciclo de vida de una garantía concreta.
///
/// Distinto de `GuaranteeStatus`, que resume en la reserva si hay garantía
/// válida y que se conserva para no romper el motor de alertas ni la entrega
/// de turno. Aquí se sigue la garantía como objeto: se toma, se mantiene
/// vigente, se devuelve, se aplica en parte, se convierte en multa o se cierra.
enum GuaranteeState {
  PENDIENTE
  VIGENTE
  DEVUELTA
  APLICADA_PARCIALMENTE
  MULTA
  CERRADA
}

/// Cómo se tomó la garantía.
enum GuaranteeKind {
  TARJETA
  EFECTIVO
  TRANSFERENCIA
  VOUCHER
  CARTA_EMPRESA
  OTRO
}

enum ReservationStatus {
  PENDIENTE
  CONFIRMADA
  EN_CASA
  SALIDA
  NO_SHOW
  CANCELADA
}

enum NotificationType {
  TAREA_ASIGNADA
  RESPONSABLE_CAMBIADO
  VENCIMIENTO_PROXIMO
  TAREA_VENCIDA
  INCIDENCIA_CRITICA
  ENTREGA_DISPONIBLE
  COMENTARIO
  /**
   * Mencionar a alguien con «@» no es comentar. El comentario avisa a los
   * interesados del registro; la mención avisa a quien se nombró, que puede no
   * tener nada que ver con él. Separados, la persona distingue «pasó algo en lo
   * mío» de «me están pidiendo algo a mí».
   */
  MENCION
  ACCION_REQUERIDA
  FRONTI_HALLAZGO
}

// =============================== IDENTIDAD ================================

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  group       String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@index([group])
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  /// Nivel jerárquico: mayor número = mayor alcance.
  level       Int              @default(10)
  /// Roles de sistema no pueden eliminarse ni renombrar su clave.
  isSystem    Boolean          @default(false)
  /// Si es false, el rol queda fuera de la operación habitual
  /// (no aparece como responsable, asignado ni en turnos).
  operational Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  grantedAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

/// Una cuenta del sistema: nombre, usuario y contraseña. Nada más.
///
/// **No tiene correo**, y es deliberado. Lo tuvo, y sobraba: en el hotel todo
/// el mesón comparte la casilla de recepción, así que el correo no
/// identificaba a nadie, no servía para entrar y sólo era un campo más que
/// alguien tenía que inventar al crear una cuenta. La identidad es `username`.
/// La casilla a la que se envían las credenciales es del HOTEL y vive en la
/// configuración de correo, no en cada persona.
model User {
  id                 String      @id @default(cuid())
  /// Nombre de usuario corto, del estilo @EHerrera. Es la identidad de la
  /// cuenta: con esto se inicia sesión y esto decide qué permisos aplican.
  username           String      @unique
  name               String
  passwordHash       String
  roleId             String
  role               Role        @relation(fields: [roleId], references: [id])
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id])
  phone              String?
  active             Boolean     @default(true)
  mustChangePassword Boolean     @default(false)
  lastLoginAt        DateTime?
  /// Cuándo terminó (o saltó) el recorrido guiado del primer ingreso.
  ///
  /// Nulo = todavía no lo hizo, así que se le ofrece. Se guarda en el usuario
  /// y no en el navegador a propósito: quien entra desde otro equipo el primer
  /// día sigue siendo alguien que ya conoce el sistema.
  tutorialDoneAt     DateTime?
  failedAttempts     Int         @default(0)
  lockedUntil        DateTime?
  isDemo             Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?
  deletedById        String?
  deletionReason     String?

  sessions              Session[]
  assignments           ShiftAssignment[]
  shiftsCreated         Shift[]             @relation("shiftCreatedBy")
  handoversIssued       ShiftHandover[]     @relation("handoverIssuedBy")
  handoversReceived     ShiftHandover[]     @relation("handoverReceivedBy")
  entriesCreated        OperationalEntry[]  @relation("entryCreatedBy")
  entriesOwned          OperationalEntry[]  @relation("entryOwner")
  entriesClosed         OperationalEntry[]  @relation("entryClosedBy")
  tasksCreated          Task[]              @relation("taskCreatedBy")
  tasksAssigned         Task[]              @relation("taskAssignee")
  followUpsOwned        FollowUp[]          @relation("followUpOwner")
  followUpsCreated      FollowUp[]          @relation("followUpCreatedBy")
  comments              Comment[]
  attachments           Attachment[]
  alertsCreated         Alert[]             @relation("alertCreatedBy")
  alertsAcknowledged    Alert[]             @relation("alertAckBy")
  alertsResolved        Alert[]             @relation("alertResolvedBy")
  auditLogs             AuditLog[]
  notifications         Notification[]
  settingsUpdated       SystemSetting[]
  mailSettingsUpdated   MailSettings[]
  checklistDone         TaskChecklistItem[]
  staysConfirmed        RoomStay[]          @relation("stayConfirmedBy")
  keysAssigned          RoomKey[]           @relation("keyAssignedBy")
  keyMovements          KeyMovement[]       @relation("keyMovementBy")
  batchesCreated        PmsImportBatch[]    @relation("batchCreatedBy")
  batchesApplied        PmsImportBatch[]    @relation("batchAppliedBy")
  guaranteesCreated     Guarantee[]         @relation("guaranteeCreatedBy")
  guaranteesReturned    Guarantee[]         @relation("guaranteeReturnedBy")
  guaranteesDeleted     Guarantee[]         @relation("guaranteeDeletedBy")
  cashCounted           CashCount[]         @relation("cashCountBy")
  cashTransfers         CashTransfer[]      @relation("cashTransferBy")
  cashFundsUpdated      CashFund[]          @relation("cashFundUpdatedBy")
  shiftsArchived        Shift[]             @relation("shiftArchivedBy")
  announcementsCreated  Announcement[]      @relation("announcementCreatedBy")
  announcementsTargeted Announcement[]      @relation("announcementTarget")
  announcementsDeleted  Announcement[]      @relation("announcementDeletedBy")
  announcementReads     AnnouncementRead[]  @relation("announcementReadBy")
  finesCreated          Fine[]              @relation("fineCreatedBy")
  finesDeleted          Fine[]              @relation("fineDeletedBy")
  checklistTemplates    ChecklistTemplate[] @relation("checklistTemplateCreatedBy")
  checklistRuns         ChecklistRun[]      @relation("checklistRunBy")
  cashMovementsCreated  CashMovement[]      @relation("cashMovementCreatedBy")
  cashMovementsVoided   CashMovement[]      @relation("cashMovementVoidedBy")
  cashAudits            CashAudit[]         @relation("cashAuditCountedBy")
  gymPassesIssued       GymPass[]           @relation("gymPassReceptionist")
  gymPassesVoided       GymPass[]           @relation("gymPassVoidedBy")
  assistantActionReceipts AssistantActionReceipt[]
  legalAcceptances        LegalAcceptance[]
  // El correo dejó de ser único, pero se sigue buscando por él (¿qué cuentas
  // usan esta casilla?), así que conserva índice propio.

  @@index([roleId])
  @@index([active])
  @@index([deletedAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  ip         String?
  userAgent  String?

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  /// Lo que escribió quien intentó entrar: ahora un nombre de usuario, no un
  /// correo. Se guarda tal cual se recibió, exista la cuenta o no.
  identifier String
  ip         String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
}

/**
 * Recibo de una confirmación ejecutable emitida por Fronti.
 *
 * El nonce vive en el token firmado y sólo puede reclamarse una vez. Esto
 * impide que un doble clic, reintento del navegador o replay cree dos tareas,
 * multas u otras acciones mutables.
 */
model AssistantActionReceipt {
  id        String   @id @default(cuid())
  nonce     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/**
 * Aceptación versionada de documentos internos.
 *
 * No se guarda el texto completo por usuario: el documento vive versionado en
 * código y esta fila prueba qué versión aceptó, cuándo y desde qué contexto.
 */
model LegalAcceptance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  document  String
  version   String
  acceptedAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@unique([userId, document, version])
  @@index([document, version])
  @@index([acceptedAt])
}

// ================================= ÁREAS ==================================

model Department {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  color     String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users   User[]
  entries OperationalEntry[]
  tasks   Task[]
  alerts  Alert[]
}

// ================================= TURNOS =================================

model Shift {
  id           String      @id @default(cuid())
  date         DateTime    @db.Date
  type         ShiftType
  status       ShiftStatus @default(PROGRAMADO)
  plannedStart DateTime
  plannedEnd   DateTime
  actualStart  DateTime?
  actualEnd    DateTime?
  notes        String?
  createdById  String?
  createdBy    User?       @relation("shiftCreatedBy", fields: [createdById], references: [id])
  startedById  String?
  closedById   String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  isDemo       Boolean     @default(false)
  /// Turno retirado de las listas operativas sin borrarlo.
  ///
  /// Distinto de ANULADO: anular es «este turno no se va a usar»; archivar es
  /// «ya pasó y no quiero verlo en las listas». Un turno archivado conserva su
  /// historia, sus registros y su entrega: sólo deja de ofrecerse y de listarse.
  archivedAt   DateTime?
  archivedById String?
  archivedBy   User?       @relation("shiftArchivedBy", fields: [archivedById], references: [id])

  assignments   ShiftAssignment[]
  handoverOut   ShiftHandover?     @relation("handoverFromShift")
  handoverIn    ShiftHandover[]    @relation("handoverToShift")
  entries       OperationalEntry[]
  tasks         Task[]
  checklistRuns ChecklistRun[]
  cashMovements CashMovement[]
  gymPasses     GymPass[]

  /**
   * NO hay unicidad por fecha+tipo, y es deliberado.
   * Esa restriccion obligaba a que existiera a lo sumo un turno por franja y
   * por dia, y de ahi salia la idea de «programar» los turnos. Los turnos se
   * crean a voluntad, asi que puede haber dos turnos de dia el mismo dia
   * (una cobertura partida, un relevo adelantado).
   * La invariante que SI se exige es «un solo turno en curso a la vez», y la
   * garantiza un indice unico PARCIAL que Prisma no sabe expresar:
   * `Shift_un_solo_turno_en_curso`, creado en la migracion
   * 20260916170000_turnos_dia_noche. Vive en SQL a proposito; el servicio
   * tambien lo comprueba para dar un mensaje legible, pero quien impide la
   * carrera entre dos recepcionistas es el indice.
   */
  @@index([status])
  @@index([date])
  @@index([archivedAt])
}

model ShiftAssignment {
  id        String         @id @default(cuid())
  shiftId   String
  shift     Shift          @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AssignmentRole @default(TITULAR)
  createdAt DateTime       @default(now())

  @@unique([shiftId, userId])
  @@index([userId])
}

model ShiftHandover {
  id                   String         @id @default(cuid())
  /// Un turno sólo puede emitir una entrega: evita entregas duplicadas.
  fromShiftId          String         @unique
  fromShift            Shift          @relation("handoverFromShift", fields: [fromShiftId], references: [id])
  toShiftId            String?
  toShift              Shift?         @relation("handoverToShift", fields: [toShiftId], references: [id])
  status               HandoverStatus @default(BORRADOR)
  issuedById           String
  issuedBy             User           @relation("handoverIssuedBy", fields: [issuedById], references: [id])
  issuedAt             DateTime?
  receivedById         String?
  receivedBy           User?          @relation("handoverReceivedBy", fields: [receivedById], references: [id])
  receivedAt           DateTime?
  /// Fotografía inmutable del estado operativo al momento de enviar la entrega.
  snapshot             Json?
  notes                String?
  receiverObservations String?
  issuerSessionId      String?
  receiverSessionId    String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  isDemo               Boolean        @default(false)

  items         HandoverItem[]
  comments      Comment[]
  tasks         Task[]
  alerts        Alert[]
  /// Arqueos de caja: el que declara quien entrega y el que confirma quien recibe.
  cashCounts    CashCount[]
  cashTransfers CashTransfer[]
  /// Elementos físicos que se traspasan junto con la caja.
  elements      HandoverElement[]

  @@index([status])
}

model HandoverItem {
  id         String        @id @default(cuid())
  handoverId String
  handover   ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  level      HandoverLevel @default(INFORMATIVO)
  /// Agrupador legible: "Incidencias abiertas", "Tareas pendientes", etc.
  section    String
  title      String
  detail     String?
  /// Referencia al registro de origen (entry|task|followup|alert|reservation).
  refType    String?
  refId      String?
  manual     Boolean       @default(false)
  order      Int           @default(0)
  createdAt  DateTime      @default(now())

  @@index([handoverId])
}

// ============================ LIBRO OPERATIVO =============================

model OperationalEntry {
  id               String      @id @default(cuid())
  seq              Int         @unique @default(autoincrement())
  type             EntryType
  title            String
  description      String
  category         String?
  departmentId     String?
  department       Department? @relation(fields: [departmentId], references: [id])
  priority         Priority    @default(MEDIA)
  status           EntryStatus @default(ABIERTO)
  occurredAt       DateTime    @default(now())
  dueAt            DateTime?
  tags             String[]    @default([])
  requiresFollowUp Boolean     @default(false)

  createdById String
  createdBy   User    @relation("entryCreatedBy", fields: [createdById], references: [id])
  ownerId     String?
  owner       User?   @relation("entryOwner", fields: [ownerId], references: [id])
  shiftId     String?
  shift       Shift?  @relation(fields: [shiftId], references: [id])

  // Una incidencia debe tener contexto: habitación o área. Se valida en
  // servidor; el esquema deja ambos campos opcionales porque los demás tipos
  // de registro no lo exigen.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id])

  guestId       String?
  guest         GuestReference?       @relation(fields: [guestId], references: [id])
  reservationId String?
  reservation   ReservationReference? @relation(fields: [reservationId], references: [id])

  // --- Campos específicos de incidencia (nulos en otros tipos) ---
  severity        Severity?
  impact          Impact?
  immediateAction String?
  rootCause       String?
  resolution      String?

  closedAt   DateTime?
  closedById String?
  closedBy   User?     @relation("entryClosedBy", fields: [closedById], references: [id])
  reopenedAt DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean   @default(false)

  tasks          Task[]
  followUps      FollowUp[]
  comments       Comment[]
  attachments    Attachment[]
  alerts         Alert[]
  checklistItems ChecklistRunItem[]
  /// El folio de gimnasio nace como registro del libro: uno por registro.
  gymPass        GymPass?

  @@index([type, status])
  @@index([status, priority])
  @@index([occurredAt])
  @@index([ownerId])
  @@index([shiftId])
  @@index([deletedAt])
  @@index([departmentId])
  @@index([roomId])
}

model Task {
  id            String     @id @default(cuid())
  seq           Int        @unique @default(autoincrement())
  title         String
  description   String?
  status        TaskStatus @default(PENDIENTE)
  priority      Priority   @default(MEDIA)
  origin        TaskOrigin @default(MANUAL)
  dueAt         DateTime?
  tags          String[]   @default([])
  blockedReason String?

  assigneeId   String?
  assignee     User?       @relation("taskAssignee", fields: [assigneeId], references: [id])
  createdById  String
  createdBy    User        @relation("taskCreatedBy", fields: [createdById], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  shiftId      String?
  shift        Shift?      @relation(fields: [shiftId], references: [id])

  entryId     String?
  entry       OperationalEntry? @relation(fields: [entryId], references: [id])
  handoverId  String?
  handover    ShiftHandover?    @relation(fields: [handoverId], references: [id])
  followUpId  String?
  followUp    FollowUp?         @relation("followUpTasks", fields: [followUpId], references: [id])
  alertId     String?
  sourceAlert Alert?            @relation("alertTasks", fields: [alertId], references: [id])

  completedAt   DateTime?
  completedById String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean   @default(false)

  checklist   TaskChecklistItem[]
  comments    Comment[]
  attachments Attachment[]
  followUps   FollowUp[]          @relation("taskFollowUps")
  alerts      Alert[]             @relation("taskAlerts")

  @@index([status, dueAt])
  @@index([createdAt])
  @@index([assigneeId, status])
  @@index([entryId])
  @@index([deletedAt])
}

model TaskChecklistItem {
  id       String    @id @default(cuid())
  taskId   String
  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text     String
  done     Boolean   @default(false)
  order    Int       @default(0)
  doneAt   DateTime?
  doneById String?
  doneBy   User?     @relation(fields: [doneById], references: [id])

  @@index([taskId])
}

model FollowUp {
  id          String         @id @default(cuid())
  action      String
  result      String?
  nextAction  String?
  scheduledAt DateTime?
  notes       String?
  status      FollowUpStatus @default(PENDIENTE)

  ownerId     String
  owner       User   @relation("followUpOwner", fields: [ownerId], references: [id])
  createdById String
  createdBy   User   @relation("followUpCreatedBy", fields: [createdById], references: [id])

  entryId String?
  entry   OperationalEntry? @relation(fields: [entryId], references: [id])
  taskId  String?
  task    Task?             @relation("taskFollowUps", fields: [taskId], references: [id])

  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean   @default(false)

  comments Comment[]
  alerts   Alert[]   @relation("followUpAlerts")
  tasks    Task[]    @relation("followUpTasks")

  @@index([status, scheduledAt])
  @@index([createdAt])
  @@index([ownerId])
  @@index([entryId])
  @@index([deletedAt])
}

model Alert {
  id           String      @id @default(cuid())
  type         AlertType
  level        AlertLevel  @default(ATENCION)
  title        String
  message      String?
  status       AlertStatus @default(NUEVA)
  dueAt        DateTime?
  snoozedUntil DateTime?
  /// Clave de deduplicación del motor automático (una alerta viva por origen).
  dedupeKey    String?     @unique
  auto         Boolean     @default(false)

  entryId       String?
  entry         OperationalEntry?     @relation(fields: [entryId], references: [id])
  taskId        String?
  task          Task?                 @relation("taskAlerts", fields: [taskId], references: [id])
  followUpId    String?
  followUp      FollowUp?             @relation("followUpAlerts", fields: [followUpId], references: [id])
  handoverId    String?
  handover      ShiftHandover?        @relation(fields: [handoverId], references: [id])
  guestId       String?
  guest         GuestReference?       @relation(fields: [guestId], references: [id])
  reservationId String?
  reservation   ReservationReference? @relation(fields: [reservationId], references: [id])
  departmentId  String?
  department    Department?           @relation(fields: [departmentId], references: [id])

  createdById      String?
  createdBy        User?     @relation("alertCreatedBy", fields: [createdById], references: [id])
  acknowledgedById String?
  acknowledgedBy   User?     @relation("alertAckBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedBy       User?     @relation("alertResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt       DateTime?
  resolutionNote   String?

  guaranteeId    String?
  guarantee      Guarantee? @relation(fields: [guaranteeId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean    @default(false)

  comments Comment[]
  tasks    Task[]    @relation("alertTasks")

  @@index([status, level])
  @@index([createdAt])
  @@index([type])
  @@index([deletedAt])
  @@index([guaranteeId])
}

model Comment {
  id             String            @id @default(cuid())
  body           String
  authorId       String
  author         User              @relation(fields: [authorId], references: [id])
  entryId        String?
  entry          OperationalEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  followUpId     String?
  followUp       FollowUp?         @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  alertId        String?
  alert          Alert?            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  handoverId     String?
  handover       ShiftHandover?    @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  /**
   * Hilo de conversación: un comentario puede responder a otro. A nivel de
   * producto es UN solo nivel —se responde a un comentario, no a una
   * respuesta— y esa regla vive en el servicio, no acá, para no tener que
   * migrar la base si mañana hace falta más profundidad.
   * Cascada a propósito: si el comentario original se elimina, sus respuestas
   * pierden todo sentido.
   */
  parentId       String?
  parent         Comment?          @relation("commentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]         @relation("commentThread")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean           @default(false)

  @@index([entryId])
  @@index([taskId])
  @@index([authorId])
  @@index([parentId])
}

model Attachment {
  id           String            @id @default(cuid())
  fileName     String
  mimeType     String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User              @relation(fields: [uploadedById], references: [id])
  entryId      String?
  entry        OperationalEntry? @relation(fields: [entryId], references: [id], onDelete: Cascade)
  taskId       String?
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  deletedAt    DateTime?
  deletedById  String?
  isDemo       Boolean           @default(false)

  @@index([entryId])
  @@index([taskId])
}

// ===================== REFERENCIAS DE HUÉSPED / RESERVA ====================
// Referencias ligeras: no reemplazan al PMS, permiten asociar registros y
// quedan listas para sincronizarse mediante `externalId`.

model GuestReference {
  id         String    @id @default(cuid())
  fullName   String
  roomNumber String?
  documentId String?
  email      String?
  phone      String?
  language   String?
  vip        Boolean   @default(false)
  notes      String?
  externalId String?   @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  isDemo     Boolean   @default(false)

  reservations ReservationReference[]
  entries      OperationalEntry[]
  alerts       Alert[]

  @@index([fullName])
  @@index([roomNumber])
}

model ReservationReference {
  id              String            @id @default(cuid())
  code            String            @unique
  guestId         String?
  guest           GuestReference?   @relation(fields: [guestId], references: [id])
  roomNumber      String?
  checkIn         DateTime?
  checkOut        DateTime?
  channel         String?
  status          ReservationStatus @default(PENDIENTE)
  guaranteeStatus GuaranteeStatus   @default(NO_REQUIERE)
  balanceDue      Decimal?          @db.Decimal(12, 2)
  requiresAction  Boolean           @default(false)
  actionNote      String?
  notes           String?
  externalId      String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  isDemo          Boolean           @default(false)

  entries       OperationalEntry[]
  alerts        Alert[]
  guarantees    Guarantee[]
  /// Estadías del PMS que se pudieron vincular a esta reserva por su código.
  stays         RoomStay[]
  fines         Fine[]
  cashMovements CashMovement[]
  gymPasses     GymPass[]

  @@index([status])
  @@index([requiresAction])
}

// ========================= TRAZABILIDAD Y SISTEMA =========================

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  summary   String
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  before    Json?
  after     Json?
  reason    String?
  ip        String?
  userAgent String?
  sessionId String?
  createdAt DateTime    @default(now())
  isDemo    Boolean     @default(false)

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  entity    String?
  entityId  String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  isDemo    Boolean          @default(false)

  @@index([userId, readAt])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  category    String   @default("general")
  description String?
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt

  @@index([category])
}

enum MailInboundProtocol {
  IMAP
  POP3
}

/// Configuración del correo del hotel, editable desde la consola.
///
/// **Una fila, no un catálogo de parámetros.** No va en `SystemSetting` por dos
/// razones: ahí el valor es `Json` y se lista genéricamente en
/// `/admin/parametros`, así que una clave de buzón quedaría a un descuido de
/// aparecer en pantalla; y el campo cifrado necesita ser una columna con nombre
/// propio —`…PasswordEnc`— para que no exista la duda de si lo que hay dentro
/// está en claro.
///
/// La clave se guarda cifrada con AES-256-GCM (`lib/secret-box.ts`) y la llave
/// de cifrado se deriva de `AUTH_SECRET`, que sigue viviendo en el entorno: la
/// base nunca contiene por sí sola lo necesario para leerla.
model MailSettings {
  /// Singleton: siempre la fila `default`. No hay dos configuraciones de correo.
  id String @id @default("default")

  // --- Salida (SMTP). Es lo único que el sistema usa hoy. ---
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  /// Cifrada. Nunca en claro, nunca devuelta al navegador.
  smtpPasswordEnc   String?
  mailFrom          String?
  /// Casilla que recibe las credenciales de los usuarios nuevos.
  credentialsMailTo String?

  // --- Entrada (IMAP/POP3). Se guarda; todavía no hay lector. ---
  inboundProtocol    MailInboundProtocol?
  inboundHost        String?
  inboundPort        Int?
  inboundUser        String?
  /// Cifrada, igual que la de salida.
  inboundPasswordEnc String?

  /// Resultado del último envío de prueba: configurar el correo a ciegas es
  /// cómo se llega a un sistema que calla en vez de avisar.
  lastTestAt     DateTime?
  lastTestOk     Boolean?
  lastTestDetail String?
  lastTestTo     String?

  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// ==================== HABITACIONES, ESTADÍAS Y LLAVES =====================
//
// Módulo que interpreta los informes del PMS y los convierte en estado
// operativo. El PMS sigue siendo la fuente principal: aquí no se administran
// reservas, se leen y se les da seguimiento en recepción.

/// Estado operativo que aporta cada informe del PMS.
enum RoomStayStatus {
  CHECK_IN
  IN_HOUSE
  CHECK_OUT
}

/// Avance de la estadía dentro del sistema, confirmado por una persona.
enum RoomStayStage {
  PENDIENTE
  CONFIRMADO
  FINALIZADO
}

enum PmsReportKind {
  ENTRADAS
  IN_HOUSE
  SALIDAS
  /// «Habitaciones con actividad»: el informe PRINCIPAL.
  ///
  /// Trae en un solo documento las ocupadas, las salidas y las entradas del
  /// día, así que ya no hace falta subir tres archivos para armar la foto
  /// operativa. Se diferencia de los otros tres en algo estructural: el estado
  /// no lo define el informe, lo define cada fila en su columna «Tipo».
  ///
  /// Los otros tres se conservan: pasan a ser secundarios o de respaldo.
  ACTIVIDAD
}

enum KeyType {
  PRINCIPAL
  COPIA
  MAESTRA
}

enum KeyStatus {
  DISPONIBLE
  ASIGNADA
  COPIA_ADICIONAL
  PENDIENTE_DEVOLUCION
  EXTRAVIADA
  FUERA_DE_SERVICIO
}

enum KeyAction {
  CREADA
  ASIGNADA
  DEVUELTA
  COPIA_ENTREGADA
  COPIA_RECUPERADA
  MARCADA_PENDIENTE_DEVOLUCION
  MARCADA_EXTRAVIADA
  MARCADA_FUERA_DE_SERVICIO
  REINTEGRADA
}

enum PmsImportStatus {
  BORRADOR
  APLICADO
  DESCARTADO
}

model Room {
  id     String  @id @default(cuid())
  number String  @unique
  floor  Int?
  kind   String?
  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stays         RoomStay[]
  keys          RoomKey[]
  entries       OperationalEntry[]
  movements     KeyMovement[]
  fines         Fine[]
  cashMovements CashMovement[]
  gymPasses     GymPass[]

  @@index([active])
}

/// Estadía normalizada: una fila de un informe del PMS, ya interpretada.
model RoomStay {
  id               String                @id @default(cuid())
  /// Código de reserva TAL COMO lo entrega el PMS. Es la fotografía de lo
  /// recibido y no se toca nunca: es la clave con la que se reconcilia.
  reservationId    String
  /// Vínculo OPCIONAL a la reserva interna, resuelto por código.
  ///
  /// Opcional a propósito: el PMS es la fuente y una estadía existe aunque
  /// nadie haya creado su reserva en el sistema. Nunca se asocia por nombre.
  reservationRefId String?
  reservationRef   ReservationReference? @relation(fields: [reservationRefId], references: [id])
  roomId           String?
  room             Room?                 @relation(fields: [roomId], references: [id])
  /// Nombres tal como los entrega el PMS. Se conservan como histórico aunque
  /// exista `reservationRef`.
  guestNames       String[]              @default([])
  channel          String?
  arrivalDate      DateTime?             @db.Date
  departureDate    DateTime?             @db.Date
  pmsStatus        String?
  sourceReport     PmsReportKind
  status           RoomStayStatus
  /// Huéspedes que declara el informe para esta estancia.
  guestCount       Int?
  /*
    Importes de ESTA estancia, no de la habitación.

    La distinción es la razón de que vivan acá: una reserva puede ocupar varias
    habitaciones con saldos distintos —en el informe real, la misma reserva
    tiene CL$ 0 pendientes en cuatro habitaciones y CL$ 15.000 en una quinta— y
    una habitación puede tener el mismo día una salida con saldo cero y una
    entrada con saldo pendiente. Un «saldo de habitación» sería falso en los
    dos casos.

    La moneda va en su propia columna y nunca se mezcla: el informe trae pesos
    y dólares a la vez.
  */
  totalAmount      Decimal?              @db.Decimal(12, 2)
  pendingAmount    Decimal?              @db.Decimal(12, 2)
  currency         String?               @db.VarChar(3)
  /// Forma de pago normalizada, y el texto tal como lo imprimió el PMS.
  ///
  /// Se conservan los dos porque de esto depende si el mesón cobra, y el PMS
  /// puede introducir formas nuevas: normalizar sin guardar el original haría
  /// perder el dato en cuanto apareciera una que no conocemos.
  paymentType      String?
  paymentTypeRaw   String?
  stage            RoomStayStage         @default(PENDIENTE)
  /// Fecha de operación del informe que originó la estadía.
  businessDate     DateTime              @db.Date

  batchId String?
  batch   PmsImportBatch? @relation(fields: [batchId], references: [id])

  confirmedAt     DateTime?
  confirmedById   String?
  confirmedBy     User?     @relation("stayConfirmedBy", fields: [confirmedById], references: [id])
  note            String?
  /// Marca que alguien intervino la estadía a mano: una importación posterior
  /// no puede deshacer esa decisión sin avisar.
  touchedManually Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletionReason String?
  isDemo         Boolean   @default(false)

  keys      RoomKey[]
  movements KeyMovement[]
  fines     Fine[]

  // Un mismo informe no puede dejar dos veces la misma reserva en la misma
  // habitación y estado para un día de operación: la importación es idempotente.
  @@unique([businessDate, reservationId, roomId, status])
  @@index([roomId, status])
  @@index([businessDate])
  @@index([reservationId])
  @@index([reservationRefId])
  @@index([stage])
  @@index([deletedAt])
}

model RoomKey {
  id     String    @id @default(cuid())
  code   String    @unique
  type   KeyType   @default(PRINCIPAL)
  status KeyStatus @default(DISPONIBLE)

  roomId String?
  room   Room?     @relation(fields: [roomId], references: [id])
  stayId String?
  stay   RoomStay? @relation(fields: [stayId], references: [id])

  assignedAt   DateTime?
  assignedById String?
  assignedBy   User?     @relation("keyAssignedBy", fields: [assignedById], references: [id])
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements KeyMovement[]

  @@index([status])
  @@index([roomId, type])
}

/// Historial de movimientos de llaves. Nunca se borra ni se edita.
model KeyMovement {
  id     String    @id @default(cuid())
  keyId  String
  key    RoomKey   @relation(fields: [keyId], references: [id], onDelete: Cascade)
  action KeyAction

  fromStatus KeyStatus?
  toStatus   KeyStatus

  roomId String?
  room   Room?     @relation(fields: [roomId], references: [id])
  stayId String?
  stay   RoomStay? @relation(fields: [stayId], references: [id])

  userId String
  user   User     @relation("keyMovementBy", fields: [userId], references: [id])
  note   String?
  at     DateTime @default(now())

  @@index([keyId, at])
  @@index([at])
}

/// Carga de informes del PMS. Se revisa antes de aplicarse.
model PmsImportBatch {
  id           String          @id @default(cuid())
  businessDate DateTime        @db.Date
  status       PmsImportStatus @default(BORRADOR)

  /// Metadatos por informe: tipo detectado, columnas, totales, nombre de archivo.
  reports Json
  /// Estadías normalizadas pendientes de aplicar.
  payload Json
  /// Recuentos y advertencias calculados al leer.
  summary Json

  createdById String
  createdBy   User      @relation("batchCreatedBy", fields: [createdById], references: [id])
  appliedAt   DateTime?
  appliedById String?
  appliedBy   User?     @relation("batchAppliedBy", fields: [appliedById], references: [id])
  discardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDemo    Boolean  @default(false)

  stays RoomStay[]

  @@index([businessDate])
  @@index([status])
}

/// Garantía tomada sobre una reserva.
///
/// Vive colgada de la reserva y no de la habitación, así que **sobrevive a un
/// cambio de habitación y a los turnos**: cambiar de habitación no la toca.
///
/// No tiene tabla de historial propia: cada cambio queda en `AuditLog` con su
/// antes y su después, igual que el resto del sistema.
model Guarantee {
  id                     String               @id @default(cuid())
  reservationReferenceId String
  reservationReference   ReservationReference @relation(fields: [reservationReferenceId], references: [id], onDelete: Cascade)

  kind     GuaranteeKind  @default(TARJETA)
  state    GuaranteeState @default(PENDIENTE)
  /// Monto tomado en garantía.
  amount   Decimal        @db.Decimal(12, 2)
  /// Código ISO de tres letras. La operación es en CLP, pero el hotel recibe
  /// huéspedes que dejan garantía en otra moneda.
  currency String         @default("CLP") @db.VarChar(3)

  /// Monto efectivamente aplicado al consumo o a daños.
  appliedAmount     Decimal?  @db.Decimal(12, 2)
  applicationReason String?
  /// Multa cobrada, distinta de lo aplicado al consumo.
  penaltyAmount     Decimal?  @db.Decimal(12, 2)
  returnedAt        DateTime?
  returnedById      String?
  returnedBy        User?     @relation("guaranteeReturnedBy", fields: [returnedById], references: [id])

  notes String?

  createdById String
  createdBy   User     @relation("guaranteeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Eliminación lógica: nada operativo se borra de verdad.
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("guaranteeDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?
  isDemo         Boolean   @default(false)

  alerts        Alert[]
  fines         Fine[]
  cashMovements CashMovement[]

  @@index([reservationReferenceId])
  @@index([state])
  @@index([deletedAt])
}

// ============================ CAJA Y ELEMENTOS =============================
//
// La caja se traspasa entre turnos con FONDO FIJO: un monto por divisa que
// SIEMPRE debe quedar en el cajón. Lo que excede ese fondo es recaudación del
// turno y sale como egreso a tesorería.
//
// El arqueo se cuenta por DENOMINACIÓN, no por total: así el conteo es
// verificable y el fondo fijo se reconstruye exacto. Se cuenta dos veces —lo
// declara quien entrega y lo confirma quien recibe— y la diferencia entre
// ambos conteos **se calcula, nunca se almacena**, igual que los conflictos de
// importación: un dato derivado que se guarda es un dato que se desincroniza.

enum CashMedium {
  BILLETE
  MONEDA
}

/// Denominación de una divisa. Catálogo: no cambia con la operación.
model CashDenomination {
  id       String          @id @default(cuid())
  currency String          @db.VarChar(3)
  value    Decimal         @db.Decimal(12, 2)
  medium   CashMedium      @default(BILLETE)
  active   Boolean         @default(true)
  order    Int             @default(0)
  lines    CashCountLine[]

  @@unique([currency, value])
  @@index([currency, active])
}

/// Fondo fijo de una divisa: lo que debe quedar en caja al entregar el turno.
///
/// NO es catálogo: es una decisión de cada hotel y se configura desde
/// `/admin/parametros`. Su existencia es la que ACTIVA la exigencia de arqueo
/// en la entrega y la recepción; un despliegue sin fondos configurados opera
/// exactamente como antes.
model CashFund {
  id          String   @id @default(cuid())
  currency    String   @unique @db.VarChar(3)
  amount      Decimal  @db.Decimal(12, 2)
  active      Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation("cashFundUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CashCountKind {
  /// Lo cuenta quien entrega el turno.
  DECLARADO
  /// Lo recuenta quien recibe. Si no coincide, la diferencia queda visible.
  CONFIRMADO
}

model CashCount {
  id          String          @id @default(cuid())
  handoverId  String
  handover    ShiftHandover   @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  kind        CashCountKind
  countedById String
  countedBy   User            @relation("cashCountBy", fields: [countedById], references: [id])
  countedAt   DateTime        @default(now())
  notes       String?
  lines       CashCountLine[]

  /// Un solo arqueo declarado y uno confirmado por entrega.
  @@unique([handoverId, kind])
  @@index([handoverId])
}

model CashCountLine {
  id             String           @id @default(cuid())
  countId        String
  count          CashCount        @relation(fields: [countId], references: [id], onDelete: Cascade)
  denominationId String
  denomination   CashDenomination @relation(fields: [denominationId], references: [id])
  quantity       Int

  @@unique([countId, denominationId])
  @@index([denominationId])
}

/// Egreso a tesorería: el excedente sobre el fondo fijo sale de la caja.
model CashTransfer {
  id          String        @id @default(cuid())
  handoverId  String
  handover    ShiftHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  currency    String        @db.VarChar(3)
  amount      Decimal       @db.Decimal(12, 2)
  /// Número de comprobante o sobre. Sin esto un egreso no es rastreable.
  reference   String?
  notes       String?
  createdById String
  createdBy   User          @relation("cashTransferBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([handoverId])
  @@index([currency])
}

/// Elemento físico que viaja con la caja. Lo define cada hotel.
model HandoverElementType {
  id       String            @id @default(cuid())
  name     String            @unique
  detail   String?
  /// Si es obligatorio, la entrega no se recibe sin confirmarlo.
  required Boolean           @default(true)
  active   Boolean           @default(true)
  order    Int               @default(0)
  elements HandoverElement[]
}

model HandoverElement {
  id            String              @id @default(cuid())
  handoverId    String
  handover      ShiftHandover       @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  elementTypeId String
  elementType   HandoverElementType @relation(fields: [elementTypeId], references: [id])
  /// Lo marca quien entrega: «está y lo dejo».
  declared      Boolean             @default(false)
  /// Lo marca quien recibe: «lo tengo en la mano».
  confirmed     Boolean             @default(false)
  notes         String?
  updatedAt     DateTime            @updatedAt

  @@unique([handoverId, elementTypeId])
  @@index([handoverId])
}

// ============================== COMUNICADOS ================================
//
// Un comunicado obligatorio BLOQUEA la interfaz hasta que la persona confirme
// que lo leyó, escribiendo algo. No es una notificación —ésas se pueden
// ignorar— y no es una alerta —ésas describen un estado del hotel—. Esto es el
// Supervisor diciendo «nadie sigue trabajando sin haber leído esto».
//
// La confirmación pide TEXTO a propósito: un botón solo se pulsa sin leer. Lo
// que se escribe queda guardado, así que después se puede saber no sólo quién
// confirmó, sino qué entendió.

enum AnnouncementScope {
  /// Todo el personal operativo.
  TODOS
  /// Una sola persona.
  USUARIO
}

model Announcement {
  id             String            @id @default(cuid())
  title          String
  body           String
  scope          AnnouncementScope @default(TODOS)
  /// Obligatorio cuando el alcance es USUARIO; nulo cuando es TODOS.
  targetUserId   String?
  targetUser     User?             @relation("announcementTarget", fields: [targetUserId], references: [id])
  /// Mientras sea true y no haya expirado, bloquea a quien no lo confirmó.
  active         Boolean           @default(true)
  /// Nulo = no caduca. Un comunicado vencido deja de bloquear.
  expiresAt      DateTime?
  createdById    String
  createdBy      User              @relation("announcementCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?             @relation("announcementDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?
  isDemo         Boolean           @default(false)

  reads AnnouncementRead[]

  @@index([active, deletedAt])
  @@index([targetUserId])
}

model AnnouncementRead {
  id               String       @id @default(cuid())
  announcementId   String
  announcement     Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation("announcementReadBy", fields: [userId], references: [id], onDelete: Cascade)
  /// Lo que escribió la persona al confirmar. Es la prueba de que leyó.
  confirmationText String
  confirmedAt      DateTime     @default(now())

  /// Una persona confirma una vez.
  @@unique([announcementId, userId])
  @@index([userId])
}

// ================================= MULTAS ==================================
//
// El formulario real del hotel para cobrar un blanco dañado. Los campos son
// los que ya se usaban en papel, con el mismo nombre, porque el papel llevaba
// años funcionando: número de reserva, habitación, huésped, tipo de blanco,
// tipo de mancha, por qué procede el cobro y qué dijo el huésped al negarse.
//
// La negativa del huésped es un campo propio y no una nota suelta a propósito:
// cuando el cobro se discute, lo que decide es haber registrado su versión en
// el momento, no recordarla después.
//
// NO reemplaza a `Guarantee`. Una multa puede cobrarse contra una garantía
// —ése es el estado MULTA que ya existe— y entonces las dos se enlazan.

enum FineKind {
  /// Blanco dañado o manchado: toallas, sábanas, cubrecamas.
  BLANCO
  /// Daño a mobiliario o instalaciones.
  DANO
  /// Falta un elemento de la habitación.
  FALTANTE
  OTRO
}

/// Tipo de blanco afectado. Es catálogo cerrado porque el cobro se tarifica.
enum LinenKind {
  TOALLA_MANO
  TOALLA_CUERPO
  TOALLA_PISO
  SABANA
  FUNDA_ALMOHADA
  CUBRECAMA
  PROTECTOR_COLCHON
  BATA
  MANTEL
  CORTINA
  OTRO
}

enum FineStatus {
  /// Registrada, todavía no se le dijo al huésped.
  REGISTRADA
  /// El huésped fue informado.
  NOTIFICADA
  /// Se cobró.
  COBRADA
  /// Se decidió no cobrar.
  CONDONADA
  /// Se registró por error.
  ANULADA
}

model Fine {
  id                     String                @id @default(cuid())
  roomId                 String
  room                   Room                  @relation(fields: [roomId], references: [id])
  /// Número de reserva tal como lo entrega el PMS. Texto, no número: el PMS
  /// puede cambiar el formato y un cero a la izquierda no se pierde.
  reservationCode        String
  /// Nombre completo del huésped, como aparece en el informe.
  guestName              String
  /// Vínculo opcional con la estadía y la reserva internas, cuando existen.
  stayId                 String?
  stay                   RoomStay?             @relation(fields: [stayId], references: [id])
  reservationReferenceId String?
  reservationReference   ReservationReference? @relation(fields: [reservationReferenceId], references: [id])

  kind           FineKind   @default(BLANCO)
  /// Obligatorio cuando el tipo es BLANCO; nulo en los demás.
  linenKind      LinenKind?
  /// Detalle libre del elemento cuando el catálogo no alcanza.
  itemDetail     String?
  /// Tipo de mancha identificada: «Maquillaje lápiz de ojos negro».
  stainType      String?
  /// Cantidad de unidades afectadas por la misma multa. Aditivo: default 1.
  quantity       Int                   @default(1)
  /// Motivo por el cual se considera procedente el cobro.
  reason         String
  /// Observaciones o antecedentes sobre la negativa del huésped.
  guestStatement String?

  amount   Decimal?   @db.Decimal(12, 2)
  currency String     @default("CLP") @db.VarChar(3)
  status   FineStatus @default(REGISTRADA)

  /// Si se cobra contra una garantía, quedan enlazadas.
  guaranteeId String?
  guarantee   Guarantee? @relation(fields: [guaranteeId], references: [id])

  createdById String
  createdBy   User     @relation("fineCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt      DateTime?
  deletedById    String?
  deletedBy      User?     @relation("fineDeletedBy", fields: [deletedById], references: [id])
  deletionReason String?
  isDemo         Boolean   @default(false)

  @@index([roomId])
  @@index([status, deletedAt])
  @@index([reservationCode])
}

// ========================= CHECKLISTS DE SUPERVISIÓN =======================
//
// El Supervisor arma sus propias listas de control y las ejecuta. Dos modelos
// y no uno: la PLANTILLA es lo que se define una vez, la EJECUCIÓN es lo que
// se recorrió un día concreto.
//
// Separarlas es lo que permite cambiar la plantilla sin reescribir la
// historia: una ejecución de marzo conserva los puntos que existían en marzo,
// porque copia su texto al ejecutarse. Si apuntara a la plantilla viva, editar
// un punto cambiaría lo que alguien ya firmó.

enum ChecklistItemResult {
  /// Sin revisar todavía.
  PENDIENTE
  /// Conforme.
  OK
  /// No conforme: exige observación.
  FALLA
  /// No aplicaba en esta ejecución.
  NO_APLICA
}

model ChecklistTemplate {
  id          String  @id @default(cuid())
  name        String
  description String?
  /// Sugerencia de cuándo recorrerla. Texto libre: «cada turno», «los lunes».
  cadence     String?
  active      Boolean @default(true)
  order       Int     @default(0)

  createdById String
  createdBy   User     @relation("checklistTemplateCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deletedAt      DateTime?
  deletionReason String?
  isDemo         Boolean   @default(false)

  items ChecklistTemplateItem[]
  runs  ChecklistRun[]

  @@index([active, deletedAt])
}

model ChecklistTemplateItem {
  id         String            @id @default(cuid())
  templateId String
  template   ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  text       String
  /// Un punto crítico que falla impide cerrar la ejecución como conforme.
  critical   Boolean           @default(false)
  order      Int               @default(0)

  @@index([templateId])
}

model ChecklistRun {
  id           String            @id @default(cuid())
  templateId   String
  template     ChecklistTemplate @relation(fields: [templateId], references: [id])
  /// Nombre de la plantilla al ejecutarse. Se copia para que la historia no
  /// cambie si después alguien renombra la plantilla.
  templateName String
  runById      String
  runBy        User              @relation("checklistRunBy", fields: [runById], references: [id])
  /// Turno en que se recorrió, si había uno abierto.
  shiftId      String?
  shift        Shift?            @relation(fields: [shiftId], references: [id])
  startedAt    DateTime          @default(now())
  /// Nulo mientras se está recorriendo.
  finishedAt   DateTime?
  notes        String?
  isDemo       Boolean           @default(false)

  items ChecklistRunItem[]

  @@index([templateId])
  @@index([runById])
  @@index([finishedAt])
}

model ChecklistRunItem {
  id          String              @id @default(cuid())
  runId       String
  run         ChecklistRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Texto del punto TAL COMO ESTABA al ejecutarse.
  text        String
  critical    Boolean             @default(false)
  order       Int                 @default(0)
  result      ChecklistItemResult @default(PENDIENTE)
  /// Obligatoria cuando el resultado es FALLA.
  observation String?
  /// Incidencia creada a partir de esta falla, si se abrió una.
  entryId     String?
  entry       OperationalEntry?   @relation(fields: [entryId], references: [id])

  @@index([runId])
}

// ==================== CAJA VIVA, GIMNASIO Y ASISTENTE ====================
//
// Estas seis tablas nacieron en SQL crudo, en la migración
// 20260916200000_caja_viva_y_folios_gimnasio, y los servicios que las usan
// (`live-cash.ts`, `gym-pass.ts`, `ai/memory.ts`) las consultan con
// `$queryRaw`. Existían en la base pero NO en este archivo, y eso es un
// peligro concreto, no una imperfección: `prisma migrate diff` las veía como
// deriva y proponía `DROP TABLE` para las seis. El primer `npm run db:migrate`
// se habría llevado la caja del turno, los folios emitidos y la memoria del
// asistente.
//
// Se declaran acá con la forma EXACTA que ya tienen en la base —columnas,
// tipos, defectos, índices y acciones de clave ajena— para que el esquema y la
// base coincidan y la diferencia quede vacía. No se genera migración: las
// tablas ya están creadas. Las llamadas en crudo siguen funcionando, y ahora
// además se pueden consultar con el cliente tipado.

/// Todo movimiento de efectivo del turno: garantías, folios, egresos.
model CashMovement {
  id                     String                @id
  kind                   String
  direction              String
  currency               String                @db.VarChar(3)
  amount                 Decimal               @db.Decimal(12, 2)
  shiftId                String?
  roomId                 String?
  reservationReferenceId String?
  guaranteeId            String?
  gymPassId              String?
  createdById            String
  reference              String?
  notes                  String?
  createdAt              DateTime              @default(now())
  /// Anulación con motivo obligatorio: el movimiento no se borra nunca.
  voidedAt               DateTime?
  voidedById             String?
  voidReason             String?
  createdBy              User                  @relation("cashMovementCreatedBy", fields: [createdById], references: [id])
  voidedBy               User?                 @relation("cashMovementVoidedBy", fields: [voidedById], references: [id])
  guarantee              Guarantee?            @relation(fields: [guaranteeId], references: [id])
  gymPass                GymPass?              @relation(fields: [gymPassId], references: [id])
  reservationReference   ReservationReference? @relation(fields: [reservationReferenceId], references: [id])
  room                   Room?                 @relation(fields: [roomId], references: [id])
  shift                  Shift?                @relation(fields: [shiftId], references: [id])

  @@index([createdAt])
  @@index([currency])
  @@index([reservationReferenceId])
  @@index([roomId])
  @@index([shiftId])
}

/// Arqueo: lo que la caja debería tener contra lo que se contó.
model CashAudit {
  id             String   @id
  currency       String   @db.VarChar(3)
  expectedAmount Decimal  @db.Decimal(12, 2)
  countedAmount  Decimal  @db.Decimal(12, 2)
  difference     Decimal  @db.Decimal(12, 2)
  countedById    String
  notes          String?
  createdAt      DateTime @default(now())
  countedBy      User     @relation("cashAuditCountedBy", fields: [countedById], references: [id])

  @@index([createdAt])
  @@index([currency])
}

/// Pase de gimnasio vendido en el mesón. El folio es correlativo de la base.
model GymPass {
  id                     String               @id
  folio                  Int                  @unique @default(autoincrement())
  reservationReferenceId String
  roomId                 String
  guestName              String
  receptionistId         String
  shiftId                String?
  operationalEntryId     String               @unique
  currency               String               @db.VarChar(3)
  amount                 Decimal              @db.Decimal(12, 2)
  paymentMethod          String
  status                 String               @default("EMITIDO")
  issuedAt               DateTime             @default(now())
  voidedAt               DateTime?
  voidedById             String?
  voidReason             String?
  cashMovements          CashMovement[]
  operationalEntry       OperationalEntry     @relation(fields: [operationalEntryId], references: [id])
  receptionist           User                 @relation("gymPassReceptionist", fields: [receptionistId], references: [id])
  voidedBy               User?                @relation("gymPassVoidedBy", fields: [voidedById], references: [id])
  reservationReference   ReservationReference @relation(fields: [reservationReferenceId], references: [id])
  room                   Room                 @relation(fields: [roomId], references: [id])
  shift                  Shift?               @relation(fields: [shiftId], references: [id])

  @@index([issuedAt])
  @@index([reservationReferenceId])
  @@index([roomId])
}

/**
 * Las tres tablas del asistente conservan su nombre en minúsculas con guión
 * bajo porque así las creó la migración y así las nombran las consultas en
 * crudo de `ai/memory.ts`. Renombrarlas exigiría una migración y reescribir
 * esas consultas, sin ganar nada.
 * Todas llevan `expires_at`: la memoria del asistente caduca, y el cron
 * `/api/cron/ai-memory` la limpia según la política de retención vigente.
 */
model ai_conversation {
  id             String       @id
  user_id        String
  session_id     String
  shift_id       String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  updated_at     DateTime     @default(now()) @db.Timestamptz(6)
  last_active_at DateTime     @default(now()) @db.Timestamptz(6)
  expires_at     DateTime     @db.Timestamptz(6)
  closed_at      DateTime?    @db.Timestamptz(6)
  ai_memory      ai_memory[]
  ai_message     ai_message[]

  @@index([expires_at], map: "ai_conversation_expires_at")
  @@index([user_id, session_id, last_active_at(sort: Desc)], map: "ai_conversation_user_session_active")
}

model ai_message {
  id              String          @id
  conversation_id String
  role            String
  content         String
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  expires_at      DateTime        @db.Timestamptz(6)
  ai_conversation ai_conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)], map: "ai_message_conversation_created_at")
  @@index([expires_at], map: "ai_message_expires_at")
}

model ai_memory {
  id              String           @id
  user_id         String
  conversation_id String?
  shift_id        String?
  scope           String
  summary         String
  entity_type     String?
  entity_id       String?
  importance      Int              @default(3)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime         @default(now()) @db.Timestamptz(6)
  expires_at      DateTime         @db.Timestamptz(6)
  ai_conversation ai_conversation? @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "ai_memory_expires_at")
  @@index([shift_id, updated_at(sort: Desc)], map: "ai_memory_shift")
  @@index([user_id, scope, updated_at(sort: Desc)], map: "ai_memory_user_scope_updated")
}
